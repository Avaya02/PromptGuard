{
  "name": "@promptguard/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema ../api-server/prisma/schema.prisma && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate --schema ../api-server/prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate --schema ../api-server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@promptguard/evaluator": "workspace:*",
    "@promptguard/llm-provider": "workspace:*",
    "@promptguard/shared-types": "workspace:*",
    "bullmq": "^5.58.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "tsx": "^4.20.5"
  }
}
